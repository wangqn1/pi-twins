+function renderImageBlock(
+	block: {
+		data?: string;
+		mimeType?: string;
+		mime_type?: string;
+		url?: string;
+		imageUrl?: string | { url?: string };
+		image_url?: string | { url?: string };
+	},
+	alt: string,
+): TemplateResult | string {
+	const data = block.data;
+	const mimeType = block.mimeType || block.mime_type || "image/png";
+	const imageUrl =
+		typeof block.imageUrl === "string"
+			? block.imageUrl
+			: typeof block.image_url === "string"
+				? block.image_url
+				: typeof block.imageUrl === "object" && block.imageUrl
+					? block.imageUrl.url
+					: typeof block.image_url === "object" && block.image_url
+						? block.image_url.url
+						: block.url;
+	const src = data ? `data:${mimeType};base64,${data}` : imageUrl;
+	if (!src) return "";
+	return html`
+		<div class="overflow-hidden rounded-lg border border-input bg-background/60">
+			<img
+				src=${src}
+				alt="${alt}"
+				class="max-w-full h-auto max-h-96 object-contain"
+			/>
+		</div>
+	`;
+}
+
+function renderAttachmentImage(attachment: Attachment): TemplateResult | string {
+	if (attachment.type !== "image") return "";
+	const data = attachment.preview || attachment.content;
+	if (!data) return "";
+	return html`
+		<div class="overflow-hidden rounded-lg border border-input bg-background/60">
+			<img
+				src="data:${attachment.mimeType};base64,${data}"
+				alt="${attachment.fileName}"
+				class="max-w-full h-auto max-h-96 object-contain"
+			/>
+		</div>
+	`;
+}
